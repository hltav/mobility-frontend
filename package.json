{
  "name": "mobility-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "preview:pwa": "node scripts/preview-pwa.mjs",
    "prepare": "husky",
    "lint:staged": "node scripts/governance/staged-check.mjs",
    "test:governance": "node --test scripts/governance/*.test.mjs",
    "lint": "eslint \"src/**/*.ts\" \"src/**/*.html\" --max-warnings=13"
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@angular/router": "21.2.25",
    "@angular/service-worker": "21.2.25",
    "leaflet": "^1.9.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@angular/build": "21.2.28",
    "@angular/cli": "21.2.28",
    "@angular/compiler-cli": "21.2.25",
    "@tailwindcss/postcss": "^4.1.12",
    "@testing-library/angular": "^19.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/leaflet": "^1.9.21",
    "husky": "9.1.7",
    "jsdom": "^28.1.0",
    "postcss": "8.5.31",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vitest": "4.1.12",
    "eslint": "10.13.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.72.0",
    "@angular-eslint/eslint-plugin": "21.4.0",
    "@angular-eslint/eslint-plugin-template": "21.4.0",
    "@angular-eslint/template-parser": "21.4.0"
  },
  "overrides": {
    "vite": "7.3.7",
    "@angular/build": {
      "undici": "7.30.1"
    },
    "@modelcontextprotocol/sdk": {
      "@hono/node-server": "1.19.15",
      "express": "5.2.1"
    }
  }
}
